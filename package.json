{
	"name": "dreamfold",
	"private": true,
	"version": "1.0.0",
	"packageManager": "pnpm@10.33.0",
	"type": "module",
	"description": "Pick a city on Google's photorealistic 3D tiles, stand in the street, and fold it over your head — vertex bending in TSL on WebGPU.",
	"license": "MIT",
	"author": "David Ronai (@makio64)",
	"keywords": [
		"threejs",
		"webgpu",
		"tsl",
		"3d-tiles",
		"photorealistic-3d-tiles",
		"google-maps",
		"inception",
		"vertex-displacement"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:with-credentials": "vite build --mode embed-tile-credentials",
		"preview": "vite preview --host"
	},
	"dependencies": {
		"3d-tiles-renderer": "0.5.1",
		"mediabunny": "^1.55.1",
		"three": "0.185.1"
	},
	"devDependencies": {
		"vite": "^8.2.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
